# Terraform generated files and local variables
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.tfvars
!*.tfvars.example

# Local environment and credentials
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.agekey
**/keys.txt
id_rsa*
id_ed25519*
*-kubeconfig
kubeconfig
**/ansible/inventories/prod/hosts.ini
**/vault*.yml
**/vault*.yaml
**/vault-pass*
vault_pass*
**/*secret*.yml
**/*secret*.yaml
!**/*.enc.yaml
*.retry
